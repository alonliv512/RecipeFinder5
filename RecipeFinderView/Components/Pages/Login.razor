@page "/login"
@rendermode InteractiveServer
@using Model
@using RecipeFinderView.Components.Shared
@inject UserSession UserSession
@inject NavigationManager Navigation
@inject HttpClient Http
<div class="container d-flex justify-content-center align-items-center" style="min-height: 85vh;" dir="rtl">
    <div class="card bg-white shadow-lg p-5 rounded-brand border-0 text-end" style="max-width: 450px; width: 100%;">

        <div class="text-center mb-4">
            <span class="bg-danger text-white rounded-circle d-inline-flex justify-content-center align-items-center shadow-sm fs-4 mb-2" style="width: 50px; height: 50px;">
                🍪
            </span>
            <h2 class="fw-bold text-dark mt-2">התחברות ל-RecipeFinder</h2>
            <p class="text-muted small">התחברו כדי ליהנות ממתכונים, מועדפים והעלאת מנות משלכם</p>
        </div>

        <div>
            <!-- שדה שם משתמש בלבד -->
            <div class="mb-3">
                <label class="form-label text-secondary fw-semibold small">שם משתמש</label>
                <input type="text" class="form-control bg-light py-2" placeholder="הקלד את שם המשתמש שלך" @bind="username" />
            </div>

            <!-- שדה סיסמה -->
            <div class="mb-4">
                <label class="form-label text-secondary fw-semibold small">סיסמה</label>
                <input type="password" class="form-control bg-light py-2" placeholder="********" @bind="password" />
            </div>

            <!-- הצגת שגיאות במידה ויש בעיה בהתחברות -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger py-2 small text-center mb-3" role="alert">
                    @errorMessage
                </div>
            }

            <button type="button" class="btn w-100 py-2 fw-bold text-white mb-3 shadow-sm" style="background-color: #4A7C59;" @onclick="HandleLogin">
                התחבר למערכת
            </button>

            <div class="text-center">
                <span class="text-muted small">עדיין אין לכם חשבון? </span>
                <a href="/register" class="text-decoration-none fw-bold" style="color: #E05A47;">הצטרפו אלינו בהרשמה חינם</a>
            </div>
        </div>

    </div>
</div>

@inject HttpClient Http
@inject NavigationManager Navigation

@code {
    private string username = "";
    private string password = "";
    private string errorMessage = "";

    // ** כאן מחליפים את הפונקציה הישנה בחדשה הזו **
    private async Task HandleLogin()
    {
        errorMessage = ""; // איפוס שגיאות קודמות
        try
        {
            Console.WriteLine("מנסה להתחבר עבור המשתמש: " + username);

            var loginDto = new
            {
                Username = username,
                Password = password
            };

            var response = await Http.PostAsJsonAsync("api/users/login", loginDto);

            Console.WriteLine("סטטוס התשובה מהשרת: " + response.StatusCode);
            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine("1. הבקשה הצליחה מול השרת!");

                var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var loginResult = await response.Content.ReadFromJsonAsync<LoginResponseDto>(options);

                if (loginResult != null)
                {
                    Console.WriteLine($"2. התקבלה תשובה מהשרת. Message: '{loginResult.Message}', User object exists: {loginResult.User != null}");
                }

                if (loginResult != null && loginResult.User != null)
                {
                    var loggedInUser = loginResult.User;
                    Console.WriteLine($"3. משתמש נמצא! שם: '{loggedInUser.Username}', מזהה: {loggedInUser.Id}");

                    await UserSession.Login(loggedInUser);
                    Console.WriteLine("4. נשמר בהצלחה ב-UserSession וב-localStorage, עובר לדף הבית...");

                    Navigation.NavigateTo("/", true);
                }
                else
                {
                    Console.WriteLine("שגיאה: loginResult או loginResult.User ריקים!");
                }
            }
            else
            {
                Console.WriteLine($"שגיאה מהשרת סטטוס: {response.StatusCode}");
                errorMessage = "התחברות נכשלה. בדוק את שם המשתמש או הסיסמה שהזנת.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("שגיאה בתקשורת: " + ex.Message);
            errorMessage = $"אירעה שגיאה בחיבור לשרת: {ex.Message}";
        }
    }
    public class LoginResponseDto
    {
        public string Message { get; set; } = string.Empty;
        public User User { get; set; } = new();
    }
}