@inherits LayoutComponentBase
@implements IDisposable
@inject UserSession UserSession
@inject NavigationManager Navigation

<div class="top-bar px-4 py-2 bg-light border-bottom d-flex justify-content-between align-items-center">
    <div class="brand-area">
        <h4 class="m-0">RecipeFinder</h4>
    </div>

    <div class="nav-links d-flex align-items-center gap-3">
        <a href="" class="text-decoration-none">דף הבית</a>

        @if (UserSession.IsLoggedIn)
        {
            <span class="fw-bold text-success">שלום, @UserSession.Username</span>
            <button class="btn btn-outline-danger btn-sm" @onclick="HandleLogout">התנתק</button>
        }
        else
        {
            <a href="login" class="text-decoration-none">התחבר</a>
            <a href="register" class="text-decoration-none">הרשמה</a>
        }
    </div>
</div>

<div class="content px-4 py-3">
    @Body
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await UserSession.InitializeAsync();
            UserSession.OnChange += OnUserSessionChanged;
            StateHasChanged(); // מעדכן את המסך לאחר טעינת הנתונים ממה ששמור בדפדפן
        }
    }

    private void OnUserSessionChanged()
    {
        // רענון אוטומטי של ה-Layout ברגע שהמשתמש מתחבר או מתנתק
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        UserSession.OnChange -= OnUserSessionChanged;
    }

    private async Task HandleLogout()
    {
        await UserSession.Logout();
        Navigation.NavigateTo("/", true);
    }
}